<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Configuration -->
    <PackageId>SpecWorks.MarkMyWord.CLI</PackageId>
    <Version>0.5.0</Version>
    <Authors>SpecWorks</Authors>
    <Company>SpecWorks</Company>
    <Description>Command-line tool for converting CommonMark markdown files to Microsoft Word (.docx) documents with syntax highlighting and Mermaid diagram support. Part of the MarkMyWord library suite.</Description>
    <PackageTags>markdown;commonmark;word;docx;converter;cli;tool;command-line;syntax-highlighting</PackageTags>
    <PackageProjectUrl>https://github.com/spec-works/MarkMyWord</PackageProjectUrl>
    <RepositoryUrl>https://github.com/spec-works/MarkMyWord</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- .NET Tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>markmyword</ToolCommandName>
  </PropertyGroup>

  <!-- Exclude the .playwright/ directory (Node.js browser infrastructure) from the
       tool package. This tree contains ~325 files and bloats the package from ~3MB
       to ~47MB. It also caused DotnetToolSettings.xml packaging failures in 0.4.0
       and 0.5.0.
       
       What stays in the package:
         - Microsoft.Playwright.dll  (C# API — required for Mermaid rendering)
         - playwright.ps1            (bootstrap script users run to install browsers)
       What gets excluded:
         - .playwright/              (Node.js package tree — installed at runtime) -->
  <Target Name="ExcludePlaywrightNodeFiles" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_PackageFiles Remove="@(_PackageFiles)"
        Condition="$([System.String]::Copy('%(Identity)').Replace('\','/').Contains('/.playwright/'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarkMyWord\MarkMyWord.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
